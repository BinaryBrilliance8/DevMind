DEVMIND_DB_PASSWORD=replace-with-private-password
DEVMIND_DATABASE=postgresql+psycopg://devmind:URL_ENCODED_PASSWORD@database:5432/devmind
DEVMIND_API_TOKEN=replace-with-random-token-of-at-least-32-characters
DEVMIND_REGISTRY=/absolute/path/to/projects.json
DEVMIND_REPOSITORIES=/absolute/path/to/repositories
DEVMIND_DOCKER_GID=999
DEVMIND_MODEL_URL=https://your-model-server.example/v1
DEVMIND_MODEL=your-served-model
DEVMIND_MODEL_KEY=
